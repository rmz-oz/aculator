msgid "Score"
msgstr "Puan"

#, python-format
msgid "%(name)s: File is larger than 1 MB."
msgstr "%(name)s: Dosya 1 MB'tan büyük."

#, python-format
msgid ""
"%(name)s: This file is an Excel workbook. Open it in Excel and use Save As "
"to export it as \"CSV UTF-8\"."
msgstr "%(name)s: Bu dosya bir Excel çalışma kitabı. Excel'de açıp Farklı Kaydet ile \"CSV UTF-8\" olarak kaydedin."

#, python-format
msgid "%(name)s: File is not UTF-8. Save it as \"CSV UTF-8\" and try again."
msgstr ""
"%(name)s: Dosya UTF-8 değil. \"CSV UTF-8\" olarak kaydedip tekrar deneyin."

#, python-format
msgid "%(name)s: File could not be read (%(error)s)."
msgstr "%(name)s: Dosya okunamadı (%(error)s)."

msgid ""
"This file is tab-separated. Keep only the student number and score columns, "
"name them student_number and score, and export as a comma- or semicolon-"
"separated CSV UTF-8 file."
msgstr "Bu dosya sekmeyle ayrılmış. Yalnız öğrenci numarası ve puan sütunlarını bırakın, adlarını student_number ve score yapın ve virgül ya da noktalı virgülle ayrılmış CSV UTF-8 olarak kaydedin."

msgid ""
"The file uses Turkish column names. Rename \"Öğrenci No\" to student_number "
"and \"Not\" to score, and keep only those two columns."
msgstr "Dosyada Türkçe sütun adları var. \"Öğrenci No\" sütununun adını student_number, \"Not\" sütununun adını score yapın ve yalnız bu iki sütunu bırakın."

msgid ""
"The header has trailing empty columns. Delete the empty columns on the right "
"and export the file again with only student_number and score."
msgstr "Başlık satırının sonunda boş sütunlar var. Sağdaki boş sütunları silin ve dosyayı yalnız student_number ve score sütunlarıyla yeniden kaydedin."

msgid "The first row must be student_number,score."
msgstr "İlk satır student_number,score olmalı."

#, python-format
msgid ""
"Student number %(number)s is in scientific notation. Set the student number "
"column to Text in Excel, enter the original student number from the class "
"list, and export the CSV again."
msgstr "%(number)s öğrenci numarası bilimsel gösterimde. Excel'de öğrenci numarası sütununu Metin yapın, numarayı sınıf listesinden yeniden girin ve CSV'yi tekrar kaydedin."

#, python-format
msgid ""
"Student number %(number)s is missing one or more leading zeros. Restore them "
"from the class list and keep the student number column formatted as Text "
"when exporting the CSV."
msgstr "%(number)s öğrenci numarasının başındaki sıfırlar düşmüş. Sınıf listesinden düzeltin ve CSV'yi kaydederken öğrenci numarası sütununu Metin biçiminde tutun."

#, python-format
msgid "%(number)s is not enrolled in this course."
msgstr "%(number)s bu derse kayıtlı değil."

#, python-format
msgid "%(name)s: File is empty."
msgstr "%(name)s: Dosya boş."

#, python-format
msgid "%(name)s: %(error)s"
msgstr "%(name)s: %(error)s"

#, python-format
msgid "%(name)s, line %(line)s"
msgstr "%(name)s, satır %(line)s"

#, python-format
msgid ""
"%(location)s: This row has trailing empty columns. Remove the extra "
"separators at the end of the row."
msgstr "%(location)s: Bu satırın sonunda boş sütunlar var. Satır sonundaki fazla ayırıcıları silin."

#, python-format
msgid "%(location)s: Expected 2 columns, found %(n)s."
msgstr "%(location)s: 2 sütun bekleniyordu, %(n)s bulundu."

#, python-format
msgid "%(location)s: Student number is empty."
msgstr "%(location)s: Öğrenci numarası boş."

#, python-format
msgid "%(location)s: %(error)s"
msgstr "%(location)s: %(error)s"

#, python-format
msgid "%(location)s: %(number)s appears again, first at %(first)s."
msgstr ""
"%(location)s: %(number)s tekrar görünüyor, ilk olarak %(first)s içinde."

#, python-format
msgid ""
"%(location)s: Score %(score)s uses a decimal comma in a comma-separated CSV. "
"Use a decimal point (%(dot)s) or export the whole file with semicolon "
"separators."
msgstr "%(location)s: %(score)s puanında virgülle ayrılmış bir CSV içinde ondalık virgül kullanılmış. Ondalık nokta kullanın (%(dot)s) ya da dosyanın tamamını noktalı virgülle ayrılmış olarak kaydedin."

#, python-format
msgid "%(name)s: File has no grade rows."
msgstr "%(name)s: Dosyada not satırı yok."

msgid "Score must be a number."
msgstr "Puan bir sayı olmalı."

#, python-format
msgid "Score must be between 0 and %(max)s."
msgstr "Puan 0 ile %(max)s arasında olmalı."

msgid "Score can have at most two decimal places."
msgstr "Puan en fazla iki ondalık basamak içerebilir."

msgid "Student number is empty."
msgstr "Öğrenci numarası boş."

msgid "Student is not enrolled in this course."
msgstr "Öğrenci bu derse kayıtlı değil."

msgid "Student appears more than once."
msgstr "Öğrenci birden fazla kez görünüyor."

