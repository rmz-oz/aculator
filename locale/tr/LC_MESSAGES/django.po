msgstr "Sayfa bulunamadı"

msgid "This page does not exist, or your account cannot open it."
msgstr "Bu sayfa yok, ya da hesabınız bu sayfayı açamaz."

msgid "Back to your start page"
msgstr "Başlangıç sayfanıza dönün"

msgid "Skip to content"
msgstr "İçeriğe geç"

msgid "Main"
msgstr "Ana gezinme"

msgid "My outcomes"
msgstr "Çıktılarım"

msgid "Courses"
msgstr "Dersler"

msgid "View as"
msgstr "Görünüm"

