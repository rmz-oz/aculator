# Generated by `python manage.py class_diagram`. Do not edit by hand.
# Render with Schibsted Grotesk (decision 0006):
#   d2 --layout elk --font-regular SchibstedGrotesk-Regular.ttf \
#      --font-bold SchibstedGrotesk-Bold.ttf docs/classes.d2 docs/classes.svg

vars: {
  d2-config: {
    layout-engine: elk
    pad: 48
  }
}

direction: right

Term: {
  shape: class
  "year": "int"
  "season": "choice(fall, spring, summer)"
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

ProgramOutcome: {
  shape: class
  "code": "str(10) unique"
  "description": "text"
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

Course: {
  shape: class
  "code": "str(20) unique"
  "name": "str(200)"
  "ects": "int"
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

CourseOffering: {
  shape: class
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

LearningOutcome: {
  shape: class
  "code": "str(10)"
  "description": "text"
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

Assessment: {
  shape: class
  "name": "str(100)"
  "max_score": "Decimal(6,2) >= 0"
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

Enrollment: {
  shape: class
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

Grade: {
  shape: class
  "score": "Decimal(6,2) >= 0"
  "clean()": ""
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

AssessmentLOWeight: {
  shape: class
  "weight": "Decimal(5,4) 0..1"
  "clean()": ""
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

LOPOWeight: {
  shape: class
  "weight": "int 1..5"
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

User: {
  shape: class
  "username": "str (django.contrib.auth)"
  style: {
    fill: "#0D1117"
    stroke: "#FFFFFF"
    font-color: "#FFFFFF"
    font-size: 16
  }
}

CourseOffering -> Course: "course, PROTECT" {
  source-arrowhead.label: "*"
  target-arrowhead.label: "1"
  style: {stroke: "#C8102E"; stroke-width: 2; font-color: "#C8102E"}
}
CourseOffering -> Term: "term, PROTECT" {
  source-arrowhead.label: "*"
  target-arrowhead.label: "1"
  style: {stroke: "#C8102E"; stroke-width: 2; font-color: "#C8102E"}
}
